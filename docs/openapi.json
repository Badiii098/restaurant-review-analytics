  "components": {
    "schemas": {
      "AnalisisBaru": {
        "properties": {
          "run_id": {
            "type": "integer",
            "title": "Run Id"
          }
        },
        "type": "object",
        "required": [
          "run_id"
        ],
        "title": "AnalisisBaru"
      },
      "AspectPriority": {
        "properties": {
          "aspect": {
            "type": "string",
            "title": "Aspect"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "rank": {
            "type": "integer",
            "title": "Rank"
          },
          "priority": {
            "type": "number",
            "title": "Priority"
          },
          "volume": {
            "type": "number",
            "title": "Volume"
          },
          "severity": {
            "type": "number",
            "title": "Severity"
          },
          "diversity": {
            "type": "number",
            "title": "Diversity"
          },
          "n_negative": {
            "type": "integer",
            "title": "N Negative"
          },
          "n_total": {
            "type": "integer",
            "title": "N Total"
          }
        },
        "type": "object",
        "required": [
          "aspect",
          "label",
          "rank",
          "priority",
          "volume",
          "severity",
          "diversity",
          "n_negative",
          "n_total"
        ],
        "title": "AspectPriority",
        "description": "Skor prioritas satu aspek beserta komponen pembentuknya.\n\nSeluruh komponen disimpan agar setiap angka dapat ditelusuri asalnya —\ninilah sifat *dapat diaudit* yang menjadi salah satu kebaruan penelitian."
      },
      "Frasa": {
        "properties": {
          "aspect": {
            "type": "string",
            "title": "Aspect"
          },
          "rank": {
            "type": "integer",
            "title": "Rank"
          },
          "phrase": {
            "type": "string",
            "title": "Phrase"
          },
          "frequency": {
            "type": "integer",
            "title": "Frequency"
          },
          "tfidf_weight": {
            "type": "number",
            "title": "Tfidf Weight"
          },
          "score": {
            "type": "number",
            "title": "Score"
          },
          "example_review_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Example Review Ids",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "aspect",
          "rank",
          "phrase",
          "frequency",
          "tfidf_weight",
          "score"
        ],
        "title": "Frasa"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Hasil": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "langkah": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Langkah"
          },
          "run": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run"
          },
          "prioritas": {
            "items": {
              "$ref": "#/components/schemas/AspectPriority"
            },
            "type": "array",
            "title": "Prioritas",
            "default": []
          },
          "frasa": {
            "items": {
              "$ref": "#/components/schemas/Frasa"
            },
            "type": "array",
            "title": "Frasa",
            "default": []
          },
          "rekomendasi": {
            "items": {
              "$ref": "#/components/schemas/Rekomendasi"
            },
            "type": "array",
            "title": "Rekomendasi",
            "default": []
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Hasil"
      },
      "Rekomendasi": {
        "properties": {
          "aspect": {
            "type": "string",
            "title": "Aspect"
          },
          "phrase": {
            "type": "string",
            "title": "Phrase"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "evidence": {
            "type": "string",
            "title": "Evidence",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "aspect",
          "phrase",
          "action"
        ],
        "title": "Rekomendasi"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}